# ──────────────────────────────────────────────────────────────
#  hope · environment configuration
#  Developer: cashholy (carti)
#
#  1. Copy this file to `.env`      ->  cp .env.example .env
#  2. Fill in your own values
#  3. NEVER commit `.env` (it is already in .gitignore)
# ──────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
BOT_TOKEN=

# Application (client) ID of the bot
CLIENT_ID=

# Your Discord user ID (enables owner-only commands)
OWNER_ID=

# PostgreSQL connection string (Neon, Supabase, Railway, local, ...)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ── Optional: general ─────────────────────────────────────────
BOT_NAME=hope
PREFIX=,
# online | idle | dnd | invisible
STATUS=online
STATUS_ROTATE_SECONDS=15
SUPPORT_SERVER=https://discord.gg/aKVsbejmrn
WEBSITE=https://hopebot.vercel.app/

# ── Optional: AI & search features ────────────────────────────
# Groq (AI chat, TTS) — extra keys are rotated automatically
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# SerpAPI (the /google command)
SERPAPI_API_KEY=

# Bytez (the image generation command)
BYTEZ_API_KEY=

# Moderation guard model override (default: llama-3.1-8b-instant)
GUARD_AI_MODEL=

# ── Optional: extra integrations ──────────────────────────────
OPENROUTER_API_KEY=
GENIUS_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
CLOUDFLARE_API_TOKEN=
